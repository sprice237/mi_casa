generator client {
  provider        = "prisma-client"
  output          = "../src/__autogenerated__/prisma"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  COMPLETE
  IN_PROGRESS
  READY_TO_BEGIN
}

model Casa {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  equipment            Equipment[]
  equipmentAttachments EquipmentAttachment[]
  equipmentNotes       EquipmentNote[]
  projects             Project[]
  recurringTasks       RecurringTask[]
  tasks                Task[]
  users                User[]
  taskTransitions      TaskTransition[]
}

model Equipment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  recurringTasks       RecurringTask[]
  tasks                Task[]
  equipmentNotes       EquipmentNote[]
  equipmentAttachments EquipmentAttachment[]
}

model EquipmentAttachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  bucketKey String
  isReady   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, createdAt(sort: Desc)])
}

model EquipmentNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz

  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, createdAt(sort: Desc)])
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  recurringTasks RecurringTask[]
  tasks          Task[]
}

model RecurringTask {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  name      String
  rule      Json
  startDate DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  equipmentId String?    @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id])

  tasks Task[]

  /**
   * rule
   * { type: 'day'; interval: number } |
   * { type: 'week'; interval: number; dow: number[] } |
   * { type: 'month_dom'; interval: number; dom: number } |
   * { type: 'month_dow'; interval: number; dow: number; wom: number } |
   * { type: 'year'; interval: number; month: number; dom: number }
   */
}

model Task {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String     @db.Uuid
  casa      Casa       @relation(fields: [casaId], references: [id])
  name      String
  status    TaskStatus
  createdAt DateTime   @default(now()) @db.Timestamptz
  updatedAt DateTime   @updatedAt @db.Timestamptz

  recurringTaskId String?        @db.Uuid
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id])

  equipmentId String?    @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id])

  taskTransitions TaskTransition[]

  @@index([recurringTaskId, createdAt(sort: Desc)])
}

model TaskTransition {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id])
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz

  prevStatus TaskStatus?
  nextStatus TaskStatus
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @unique @db.Citext
  password String

  casaId          String           @db.Uuid
  casa            Casa             @relation(fields: [casaId], references: [id])
  taskTransitions TaskTransition[]
}
