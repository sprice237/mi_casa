generator client {
  provider        = "prisma-client"
  output          = "../src/__autogenerated__/prisma"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

enum ExpoNotificationPlatform {
  ANDROID
  IOS
}

enum TaskStatus {
  COMPLETE
  IN_PROGRESS
  READY_TO_BEGIN
}

model ActivityFeed {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz

  entries        ActivityFeedEntry[]
  equipment      Equipment[]
  recurringTasks RecurringTask[]
  tasks          Task[]
}

model ActivityFeedEntry {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId         String       @db.Uuid
  casa           Casa         @relation(fields: [casaId], references: [id])
  activityFeedId String       @db.Uuid
  activityFeed   ActivityFeed @relation(fields: [activityFeedId], references: [id])
  createdAt      DateTime     @default(now()) @db.Timestamptz
  userId         String?      @db.Uuid
  user           User?        @relation(fields: [userId], references: [id])

  note        String?
  attachments Attachment[]
}

model Attachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  bucketKey String
  isReady   Boolean
  mimeType  String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  activityFeedEntries ActivityFeedEntry[]

  @@index([casaId])
}

model Casa {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  activityFeeds          ActivityFeed[]
  activityFeedEntries    ActivityFeedEntry[]
  attachments            Attachment[]
  equipment              Equipment[]
  projects               Project[]
  recurringTasks         RecurringTask[]
  tasks                  Task[]
  users                  User[]
  taskTransitions        TaskTransition[]
  expoNotificationTokens ExpoNotificationToken[]
}

model Equipment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId         String       @db.Uuid
  casa           Casa         @relation(fields: [casaId], references: [id])
  activityFeedId String       @db.Uuid
  activityFeed   ActivityFeed @relation(fields: [activityFeedId], references: [id])
  name           String
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  recurringTasks RecurringTask[]
  tasks          Task[]
}

model ExpoNotificationToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  deviceId String

  casaId String @db.Uuid
  casa   Casa   @relation(fields: [casaId], references: [id])

  platform      ExpoNotificationPlatform
  expoPushToken String
  createdAt     DateTime                 @default(now()) @db.Timestamptz

  @@unique([deviceId])
  @@unique([expoPushToken])
  @@index([userId])
  @@index([casaId])
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  recurringTasks RecurringTask[]
  tasks          Task[]
}

model RecurringTask {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId         String       @db.Uuid
  casa           Casa         @relation(fields: [casaId], references: [id])
  activityFeedId String       @db.Uuid
  activityFeed   ActivityFeed @relation(fields: [activityFeedId], references: [id])
  name           String
  rule           Json
  startDate      DateTime     @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  equipmentId String?    @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id])

  tasks Task[]

  /**
   * rule
   * { type: 'day'; interval: number } |
   * { type: 'week'; interval: number; dow: number[] } |
   * { type: 'month_dom'; interval: number; dom: number } |
   * { type: 'month_dow'; interval: number; dow: number; wom: number } |
   * { type: 'year'; interval: number; month: number; dom: number }
   */
}

model Task {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId         String       @db.Uuid
  casa           Casa         @relation(fields: [casaId], references: [id])
  activityFeedId String       @db.Uuid
  activityFeed   ActivityFeed @relation(fields: [activityFeedId], references: [id])
  name           String
  status         TaskStatus
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  recurringTaskId String?        @db.Uuid
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id])

  equipmentId String?    @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id])

  taskTransitions TaskTransition[]

  @@index([recurringTaskId, createdAt(sort: Desc)])
}

model TaskTransition {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casaId    String   @db.Uuid
  casa      Casa     @relation(fields: [casaId], references: [id])
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id])
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz

  prevStatus TaskStatus?
  nextStatus TaskStatus
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @unique @db.Citext
  password String

  casaId String @db.Uuid
  casa   Casa   @relation(fields: [casaId], references: [id])

  taskTransitions        TaskTransition[]
  expoNotificationTokens ExpoNotificationToken[]
  activityFeedEntries    ActivityFeedEntry[]
}
