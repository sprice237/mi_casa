generator client {
  provider        = "prisma-client"
  output          = "../src/__autogenerated__/prisma"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  COMPLETE
  IN_PROGRESS
  READY_TO_BEGIN
}

model Equipment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  recurringTasks       RecurringTask[]
  tasks                Task[]
  equipmentNotes       EquipmentNote[]
  equipmentAttachments EquipmentAttachment[]
}

model EquipmentAttachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucketKey String
  isReady   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, createdAt(sort: Desc)])
}

model EquipmentNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz

  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, createdAt(sort: Desc)])
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  recurringTasks RecurringTask[]
  tasks          Task[]
}

model RecurringTask {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  rule      Json
  startDate DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  equipmentId String?    @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id])

  tasks Task[]

  /**
   * rule
   * { type: 'day'; interval: number } |
   * { type: 'week'; interval: number; dow: number[] } |
   * { type: 'month_dom'; interval: number; dom: number } |
   * { type: 'month_dow'; interval: number; dow: number; wom: number } |
   * { type: 'year'; interval: number; month: number; dom: number }
   */
}

model Task {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    TaskStatus
  createdAt DateTime   @default(now()) @db.Timestamptz
  updatedAt DateTime   @updatedAt @db.Timestamptz

  recurringTaskId String?        @db.Uuid
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id])

  equipmentId String?    @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id])

  @@index([recurringTaskId, createdAt(sort: Desc)])
}
