generator client {
  provider = "prisma-client"
  output   = "../src/__autogenerated__/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  COMPLETE
  IN_PROGRESS
  READY_TO_BEGIN
}

model Task {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  status TaskStatus
}
