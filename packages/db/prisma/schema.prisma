generator client {
  provider        = "prisma-client"
  output          = "../src/__autogenerated__/prisma"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  COMPLETE
  IN_PROGRESS
  READY_TO_BEGIN
}

model RecurringTask {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  rule      Json
  startDate DateTime @db.Date

  /**
   * rule
   * { type: 'day'; interval: number } |
   * { type: 'week'; interval: number; dow: number[] } | 
   * { type: 'month_dom'; interval: number; dom: number } |
   * { type: 'month_dow'; interval: number; dow: number; wom: number } |
   * { type: 'year'; interval: number; month: number; dom: number }
   */
}

model Task {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  status TaskStatus
}
