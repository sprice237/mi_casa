{
  "name": "@mi_casa/gql",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema.graphql": "./dist/schema.graphql"
  },
  "main": "dist",
  "scripts": {
    "build": "graphql-codegen --config src/gql-codegen.ts",
    "watch": "graphql-codegen --config src/gql-codegen.ts --watch"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/typescript": "5.0.2",
    "@graphql-codegen/typescript-resolvers": "5.1.0",
    "@parcel/watcher": "2.5.1",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "graphql": "^16.12.0"
  }
}