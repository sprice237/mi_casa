FROM node:24.13.0-alpine AS builder
WORKDIR /app
COPY . .
RUN npm i
RUN npm run build --if-present -w packages -w apps/api

FROM node:24.13.0-alpine AS installer
WORKDIR /app
COPY --from=builder /app .
RUN npm i
RUN npm run build --if-present -w packages -w apps/api

FROM public.ecr.aws/lambda/nodejs:24
COPY --from=installer /app ${LAMBDA_TASK_ROOT}
WORKDIR ${LAMBDA_TASK_ROOT}/apps/api/dist

CMD ["lambda.handler"]
