FROM node:24.13.0-slim AS builder
WORKDIR /app
COPY . .
RUN npm i
RUN npm run clean --if-present -ws
RUN npm run build --if-present -w packages -w apps/api

FROM public.ecr.aws/lambda/nodejs:24
WORKDIR ${LAMBDA_TASK_ROOT}
COPY --from=builder /app .
RUN npm i --omit=dev

CMD ["apps/api/dist/lambda.handler"]
