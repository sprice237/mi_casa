{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": [
      "ES2023"
    ],
    "target": "ES2015"
  },
  "references": [
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/gql"
    }
  ],
}