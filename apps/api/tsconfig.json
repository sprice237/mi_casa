{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": [
      "ES2023"
    ],
    "target": "ES2015"
  }
}