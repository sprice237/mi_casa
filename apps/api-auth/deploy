#!/usr/bin/env bash
ECR_URL=038462757834.dkr.ecr.us-east-1.amazonaws.com
IMAGE_NAME=mi-casa/api-auth
IMAGE_TAG=latest
AWS_LAMBDA_FUNCTION=mi-casa-api-auth
DOCKER_FILE=apps/api-auth/Dockerfile.awslambda
PLATFORM=linux/arm64

IMAGE_URI="$ECR_URL/$IMAGE_NAME:$IMAGE_TAG"

set -e

pushd $(dirname "$0")/../..
docker rmi -f "$IMAGE_URI" || true
docker buildx build -f "$DOCKER_FILE" --platform "$PLATFORM" --provenance=false -t "$IMAGE_URI" .
docker push "$IMAGE_URI"
aws lambda update-function-code --function-name "$AWS_LAMBDA_FUNCTION" --image-uri "$IMAGE_URI" --no-cli-pager
